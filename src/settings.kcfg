<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0 http://www.kde.org/standards/kcfg/1.0/kcfg.xsd">
  <!-- App-wide settings. Everything a screen shows is in profilesettings.kcfg. -->
  <kcfgfile name="kde-wallpaper-slideshowrc"/>

  <group name="General">
    <entry name="separateScreens" type="Bool"><default>false</default></entry>
    <entry name="disabledScreens" type="StringList"><default></default></entry>
    <entry name="watchChanges" type="Bool"><default>true</default></entry>
    <entry name="autostart" type="Bool"><default>false</default></entry>
    <entry name="pauseOnLock" type="Bool"><default>true</default></entry>
    <entry name="pauseOnFullscreen" type="Bool"><default>true</default></entry>
    <entry name="preventSleep" type="Bool"><default>false</default></entry>
    <entry name="preventScreenOff" type="Bool"><default>false</default></entry>
    <!-- Whether the two above also hold while paused if a video keeps playing. -->
    <entry name="preventWhilePausedVideo" type="Bool"><default>false</default></entry>
    <entry name="pauseOnSleepOrLock" type="Bool"><default>false</default></entry>
    <entry name="hideOnSleepOrLock" type="Bool"><default>false</default></entry>
    <!-- What clicking and double-clicking the tray icon do. Both use the same
         choices; TrayController reads both as EnumTrayClick. New choices go at the end,
         since the index is what is stored. -->
    <entry name="trayClick" type="Enum">
      <choices><choice name="Nothing"/><choice name="OpenSettings"/><choice name="Play"/><choice name="Pause"/><choice name="Previous"/><choice name="Next"/><choice name="First"/><choice name="Last"/><choice name="Shuffle"/><choice name="Rescan"/><choice name="ToggleShown"/><choice name="Show"/><choice name="Hide"/><choice name="ToggleMute"/><choice name="TogglePreventSleep"/><choice name="TogglePause"/></choices>
      <default>OpenSettings</default>
    </entry>
    <entry name="trayDoubleClick" type="Enum">
      <choices><choice name="Nothing"/><choice name="OpenSettings"/><choice name="Play"/><choice name="Pause"/><choice name="Previous"/><choice name="Next"/><choice name="First"/><choice name="Last"/><choice name="Shuffle"/><choice name="Rescan"/><choice name="ToggleShown"/><choice name="Show"/><choice name="Hide"/><choice name="ToggleMute"/><choice name="TogglePreventSleep"/><choice name="TogglePause"/></choices>
      <default>Nothing</default>
    </entry>
  </group>
</kcfg>
